{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@cabmora/ui": [
        "../../packages/ui/src"
      ],
      "@cabmora/ui/*": [
        "../../packages/ui/src/*"
      ],
      "@cabmora/api-client": [
        "../../packages/api-client/src"
      ]
    }
  },
  "include": [
    "src",
    "../../packages/ui/src",
    "../../packages/api-client/src"
  ]
}
