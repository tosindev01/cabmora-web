# Cabmora web — nginx runtime config
#
# Two jobs:
#   1. Serve the built SPA with correct cache semantics.
#   2. Reverse-proxy /api to the cabmora-api deployment.
#
# (2) is what makes the frontend work unchanged in production:
# packages/api-client/src/client.ts uses a RELATIVE base URL ("/api/v1"), so the browser
# calls the same origin it loaded from. No absolute API URL is baked at build
# time, and no CORS preflight happens in production.

# Rate limit for the public enquiry form.
#
# `POST /api/v1/enquiries` is the only unauthenticated write in the API, and a
# lead pipeline full of spam is worse than no pipeline. Five a minute per IP is
# far above what a person filling in a form needs and far below what a script
# wants. Declared at http level because a zone cannot be defined inside
# `server`; nginx's default include puts this file in that context, so the
# directive sits above the block.
limit_req_zone $binary_remote_addr zone=cabmora_enquiries:10m rate=5r/m;

server {
    # Railway injects PORT and routes to it; the container MUST listen there.
    # Substituted at container start by the nginx image's envsubst entrypoint,
    # with a local default of 8080 for docker-compose.
    listen       ${PORT};
    server_name  _;

    # ── One canonical hostname ───────────────────────────────────────────
    # `cabmoramedia.com` and `www.cabmoramedia.com` serve identical content.
    # Left as two, search engines index them as two sites and split the
    # ranking between them, and a visitor can hold a session on one host
    # while appearing signed out on the other — cookies are scoped by host.
    #
    # The bare domain wins because everything else already assumes it:
    # PUBLIC_BASE_URL, the Mailtrap sender, and every link in an invite,
    # password reset or invoice email.
    #
    # Hardcoded rather than an env var: NGINX_ENVSUBST_FILTER only
    # substitutes API_UPSTREAM, PORT and NGINX_RESOLVER, so a `${...}` here
    # would survive into the config and fail nginx's parse. It costs nothing
    # to hardcode — no other environment answers to this name, so the test is
    # simply never true on staging or on the *.up.railway.app hostname.
    #
    # `https://` is literal, not `$scheme`: Railway terminates TLS at its
    # edge and proxies to this container over plain HTTP, so `$scheme` here
    # is always `http` and would redirect visitors out of TLS.
    if ($host = www.cabmoramedia.com) {
        return 301 https://cabmoramedia.com$request_uri;
    }

    if ($host ~* ^admin\.) {
        rewrite ^/$ /admin/dashboard redirect;
        rewrite ^/login$ /admin/login redirect;
    }


    # Re-resolve the upstream on every request instead of once at startup.
    #
    # `valid=10s` caps how long a resolved address is trusted. Railway hands the
    # API a new private IP on each deploy, and without this nginx would keep the
    # first one until the container restarted — which is why the frontends went
    # dark after every API deploy until they were redeployed too.
    #
    # The resolver address is discovered per environment by
    # docker-entrypoint.d/15-resolver.envsh; hard-coding Docker's 127.0.0.11
    # here is what made an earlier attempt unportable.
    resolver ${NGINX_RESOLVER} valid=10s;
    resolver_timeout 5s;

    root  /usr/share/nginx/html;
    index index.html;

    # Do not advertise the nginx version.
    server_tokens off;

    # Never build an absolute URL for a redirect. Railway terminates TLS and
    # proxies here over plain HTTP on an internal port, so nginx's own idea of
    # scheme and port is wrong — a directory redirect came out as
    # `http://cabmoramedia.com:8080/about/`, which is the wrong scheme and a
    # port nothing outside the container can reach. Relative redirects are
    # resolved by the browser against the address it actually used.
    absolute_redirect off;
    port_in_redirect off;

    # Baseline security headers.
    add_header X-Content-Type-Options "nosniff"        always;
    add_header X-Frame-Options        "SAMEORIGIN"     always;
    add_header Referrer-Policy        "strict-origin-when-cross-origin" always;

    gzip              on;
    gzip_vary         on;
    gzip_min_length   1024;
    gzip_proxied      any;
    gzip_types        text/plain text/css application/javascript application/json
                      image/svg+xml application/xml font/woff font/woff2;

    # ── Public enquiry form ──────────────────────────────────
    # Must come before `location /api/` — nginx prefers an exact match, so this
    # wins for exactly this path and everything else falls through unthrottled.
    location = /api/v1/enquiries {
        limit_req zone=cabmora_enquiries burst=3 nodelay;
        # 429 rather than nginx's default 503: this is the client's rate, not
        # the server being unavailable, and a monitor should not page for it.
        limit_req_status 429;

        # A variable, not a literal: nginx only defers DNS to request time when
        # the upstream is a variable. `$request_uri` is appended explicitly
        # because a variable proxy_pass does not rewrite the path the way a
        # literal one does — without it every request would hit /.
        set $cabmora_api ${API_UPSTREAM};
        proxy_pass         http://$cabmora_api$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ── API reverse proxy ────────────────────────────────────
    location /api/ {
        # ${API_UPSTREAM} is substituted at CONTAINER START by the nginx
        # image's envsubst entrypoint, so this line becomes a literal host:port
        # before nginx ever parses it. Points at wherever cabmora-api lives:
        # a compose service name locally, api.railway.internal on Railway.
        #
        # Resolved per request via the `resolver` above — see 15-resolver.envsh
        # for how its address is discovered.
        # A variable, not a literal: nginx only defers DNS to request time when
        # the upstream is a variable. `$request_uri` is appended explicitly
        # because a variable proxy_pass does not rewrite the path the way a
        # literal one does — without it every request would hit /.
        set $cabmora_api ${API_UPSTREAM};
        proxy_pass         http://$cabmora_api$request_uri;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Media uploads land here in Phase 3 — do not cap at nginx's 1m default.
        client_max_body_size 512m;

        proxy_connect_timeout 30s;
        proxy_send_timeout    300s;
        proxy_read_timeout    300s;
    }

    # ── Gallery share links ──────────────────────────────────
    # `/s/<token>` goes to the API, not to the SPA.
    #
    # A share link pasted into WhatsApp, Slack or iMessage is fetched by that
    # service before any person sees it, and what it gets back decides the
    # preview. Served as the SPA it got index.html — the site's own title and
    # stock photograph — so every gallery unfurled identically. The API answers
    # with Open Graph tags for that specific gallery and forwards a person on
    # to /gallery/<token>, which the SPA still serves.
    #
    # The trailing slash matters: this must not catch /settings, /signup,
    # /storage or /split, which are SPA routes that merely begin with "s".
    location /s/ {
        set $cabmora_api ${API_UPSTREAM};
        proxy_pass         http://$cabmora_api$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ── Static assets ────────────────────────────────────────
    # Vite emits content-hashed filenames, so these are safe to cache forever.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
        try_files $uri =404;
    }

    # ── Admin Console SPA (/admin and /admin/*) ──────────────
    # Serves the built @cabmora/admin bundle directly so visiting /admin/team
    # or /admin/login works on the main deployment as well as on admin.* hosts
    # instead of falling through to apps/web's catch-all redirect to `/`.
    location ^~ /admin {
        root /usr/share/nginx;
        try_files $uri /admin/index.html;
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    # ── SPA fallback ─────────────────────────────────────────
    # index.html must NEVER be cached, or clients pin to a stale asset manifest
    # after a deploy and the app white-screens.
    location / {
        # `$uri.html` before `$uri/`: the SEO build writes /about.html, and
        # serving it directly avoids the directory redirect nginx would
        # otherwise issue. See below for why that redirect was harmful.
        try_files $uri $uri.html $uri/ /index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    # Container-level liveness probe. Distinct from the API's /api/v1/health.
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }
}
