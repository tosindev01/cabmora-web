# Cabmora Web — environment for docker-compose.prod.yml
#
#   cp .env.example .env
#
# The dev stack (docker-compose.yml) has safe defaults inline and does not need
# this file. Never commit .env — it is gitignored.

# ── API ───────────────────────────────────────────────────
# host:port of the cabmora-api deployment that nginx proxies /api to.
# No scheme, no trailing slash. Substituted into the nginx config at container
# start, so the same image works in every environment.
#
#   local (API compose running on the host):  host.docker.internal:8000
#   production:                               api.railway.internal:8000
#   no API yet (frontend-only deploy):        127.0.0.1:9
#
# The placeholder MUST be an IP literal. nginx resolves hostnames once at
# startup and exits if DNS fails, so a made-up hostname would stop the
# container booting. An IP needs no resolution: nginx starts, the SPA serves
# normally, and /api returns 502 until a real API exists.
API_UPSTREAM=host.docker.internal:8000

# Dev-stack override: where the Vite dev proxy sends /api. Full URL, with scheme.
#   API_TARGET=https://api-staging.cabmora.com

# ── Ports ─────────────────────────────────────────────────
WEB_PORT=8080

# Admin is published on 127.0.0.1 only (see docker-compose.prod.yml). Expose it
# through an edge proxy with Cloudflare Access or an IP allowlist — never by
# publishing this port directly.
ADMIN_PORT=8081

# ── Images ────────────────────────────────────────────────
# Tag built images per release/environment rather than reusing `latest`.
IMAGE_TAG=latest
